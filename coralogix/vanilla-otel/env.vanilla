# OpenTelemetry Demo - Vanilla Host Deployment Environment Variables
# Copy this file to .env and update the values as needed

# OpenTelemetry Collector Configuration
OTEL_COLLECTOR_HOST=localhost
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318

# Demo Application Configuration
IMAGE_NAME=otel-demo
DEMO_VERSION=latest
IMAGE_VERSION=latest

# OpenTelemetry Collector Version
OTELCOL_CONTRIB_VERSION=0.131.1

# Service Ports
FRONTEND_PORT=3000
CART_PORT=8081
CHECKOUT_PORT=8082
CURRENCY_PORT=8083
EMAIL_PORT=8084
PAYMENT_PORT=8085
PRODUCT_CATALOG_PORT=8086
QUOTE_PORT=8087
RECOMMENDATION_PORT=8088
SHIPPING_PORT=8089
LOAD_GENERATOR_PORT=8089

# Infrastructure Service Ports
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181

# Observability Ports
JAEGER_PORT=16686
PROMETHEUS_PORT=9090
OPENSEARCH_PORT=9200

# Resource Attributes
OTEL_RESOURCE_ATTRIBUTES=service.name=otel-demo,service.version=1.0.0,deployment.environment=host

# Load Generator Configuration
LOCUST_USERS=10
LOCUST_HOST=http://localhost:3000
LOCUST_HEADLESS=false
LOCUST_AUTOSTART=true

# Service Addresses (for inter-service communication)
FRONTEND_ADDR=http://localhost:3000
AD_ADDR=http://localhost:8080
CART_ADDR=http://localhost:8081
CHECKOUT_ADDR=http://localhost:8082
CURRENCY_ADDR=http://localhost:8083
EMAIL_ADDR=http://localhost:8084
PAYMENT_ADDR=http://localhost:8085
PRODUCT_CATALOG_ADDR=http://localhost:8086
QUOTE_ADDR=http://localhost:8087
RECOMMENDATION_ADDR=http://localhost:8088
SHIPPING_ADDR=http://localhost:8089

# Database Configuration
DB_CONNECTION_STRING=Host=localhost;Username=root;Password=otel;Database=otel
VALKEY_ADDR=localhost:6379
KAFKA_ADDR=localhost:9092

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
OTEL_LOGS_EXPORTER=otlp
OTEL_PYTHON_LOG_CORRELATION=true
OTEL_PHP_AUTOLOAD_ENABLED=true
OTEL_PHP_INTERNAL_METRICS_ENABLED=true
