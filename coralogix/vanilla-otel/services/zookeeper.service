[Unit]
Description=Zookeeper for OpenTelemetry Demo
After=network.target
Wants=network.target

[Service]
Type=simple
User=zookeeper
Group=zookeeper
ExecStart=/usr/local/bin/zookeeper-server-start /opt/kafka/config/zookeeper.properties
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zookeeper
WorkingDirectory=/var/lib/zookeeper

# Environment
Environment=ZOOKEEPER_CLIENT_PORT=2181
Environment=ZOOKEEPER_TICK_TIME=2000
Environment=ZOOKEEPER_DATA_DIR=/var/lib/zookeeper/data
Environment=ZOOKEEPER_LOG_DIR=/var/lib/zookeeper/logs

# Resource limits
MemoryMax=512M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
