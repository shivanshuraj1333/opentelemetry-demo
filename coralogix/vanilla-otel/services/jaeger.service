[Unit]
Description=Jaeger Tracing UI
After=network.target
Wants=network.target

[Service]
Type=simple
User=jaeger
Group=jaeger
ExecStart=/usr/local/bin/jaeger-all-in-one --memory.max-traces=25000 --query.base-path=/jaeger/ui
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jaeger
WorkingDirectory=/var/lib/jaeger

# Environment
Environment=JAEGER_PORT=16686
Environment=JAEGER_GRPC_PORT=14250

# Resource limits
MemoryMax=1G
CPUQuota=30%

[Install]
WantedBy=multi-user.target
