[Unit]
Description=Kafka Message Broker for OpenTelemetry Demo
After=network.target zookeeper.service
Wants=network.target
Requires=zookeeper.service

[Service]
Type=simple
User=kafka
Group=kafka
ExecStart=/usr/bin/kafka-server-start /etc/kafka/server.properties
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kafka
WorkingDirectory=/var/lib/kafka

# Environment
Environment=KAFKA_ZOOKEEPER_CONNECT=localhost:2181
Environment=KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092
Environment=KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:9092
Environment=KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
Environment=KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
Environment=KAFKA_LOG_DIRS=/var/lib/kafka-logs
Environment=KAFKA_HEAP_OPTS=-Xmx400m -Xms400m

# Resource limits
MemoryMax=1G
CPUQuota=40%

[Install]
WantedBy=multi-user.target
