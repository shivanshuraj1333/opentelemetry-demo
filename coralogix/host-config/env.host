# OpenTelemetry Demo - Host Deployment Environment Variables
# Copy this file to .env and update the values as needed

# Coralogix Configuration
CORALOGIX_PRIVATE_KEY=your_coralogix_private_key_here
CORALOGIX_DOMAIN=app.staging.coralogix.net

# OpenTelemetry Collector Configuration
OTEL_COLLECTOR_HOST=localhost
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318

# Demo Application Configuration
IMAGE_NAME=otel-demo
DEMO_VERSION=latest
IMAGE_VERSION=latest

# OpenTelemetry Collector Version
OTELCOL_CONTRIB_VERSION=0.131.1

# Service Ports (if running directly on host)
FRONTEND_PORT=3000
CART_PORT=8081
CHECKOUT_PORT=8082
CURRENCY_PORT=8083
EMAIL_PORT=8084
PAYMENT_PORT=8085
PRODUCT_CATALOG_PORT=8086
QUOTE_PORT=8087
RECOMMENDATION_PORT=8088
SHIPPING_PORT=8089
LOAD_GENERATOR_PORT=8089

# Infrastructure Service Ports
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
ZOOKEEPER_PORT=2181

# Resource Attributes
OTEL_RESOURCE_ATTRIBUTES=service.name=otel-demo,service.version=1.0.0,deployment.environment=host

# Load Generator Configuration
LOCUST_USERS=10
LOCUST_HOST=http://localhost:3000
LOCUST_HEADLESS=false
LOCUST_AUTOSTART=true
