[Unit]
Description=Coralogix OpenTelemetry Agent
Documentation=https://coralogix.com/docs/opentelemetry-agent/
After=network.target
Wants=network.target

[Service]
Type=simple
User=otelcol
Group=otelcol
ExecStart=/usr/local/bin/otelcol-contrib --config=/etc/otelcol/agent.yaml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coralogix-agent

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/otelcol
ReadOnlyPaths=/etc/otelcol
ReadOnlyPaths=/hostfs
ReadOnlyPaths=/var/log

# Resource limits
MemoryMax=512M
CPUQuota=50%

# Environment
Environment=CORALOGIX_PRIVATE_KEY=%i
EnvironmentFile=-/etc/otelcol/coralogix.env

[Install]
WantedBy=multi-user.target
