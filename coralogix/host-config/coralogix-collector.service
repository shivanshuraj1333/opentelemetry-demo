[Unit]
Description=Coralogix OpenTelemetry Collector
Documentation=https://coralogix.com/docs/opentelemetry-collector/
After=network.target
Wants=network.target

[Service]
Type=simple
User=otelcol
Group=otelcol
ExecStart=/usr/local/bin/otelcol-contrib --config=/etc/otelcol/collector.yaml
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coralogix-collector

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/otelcol
ReadOnlyPaths=/etc/otelcol

# Resource limits
MemoryMax=1G
CPUQuota=100%

# Environment
Environment=CORALOGIX_PRIVATE_KEY=%i
EnvironmentFile=-/etc/otelcol/coralogix.env

[Install]
WantedBy=multi-user.target
