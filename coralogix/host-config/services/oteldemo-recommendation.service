[Unit]
Description=OpenTelemetry Demo - Recommendation Service
After=network.target coralogix-collector.service product-catalog.service
Wants=network.target

[Service]
Type=simple
User=oteldemo
Group=oteldemo
WorkingDirectory=/opt/oteldemo/recommendation
ExecStart=/usr/bin/python3 recommendation_server.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oteldemo-recommendation

# Environment
Environment=RECOMMENDATION_PORT=8085
Environment=PRODUCT_CATALOG_ADDR=http://localhost:8084
Environment=OTEL_PYTHON_LOG_CORRELATION=true
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
Environment=OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
Environment=OTEL_SERVICE_NAME=recommendation
Environment=OTEL_RESOURCE_ATTRIBUTES=service.name=recommendation,service.version=1.0.0,deployment.environment=host
Environment=PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# Resource limits
MemoryMax=256M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
