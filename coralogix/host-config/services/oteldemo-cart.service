[Unit]
Description=OpenTelemetry Demo - Cart Service
After=network.target coralogix-collector.service redis.service
Wants=network.target

[Service]
Type=simple
User=oteldemo
Group=oteldemo
WorkingDirectory=/opt/oteldemo/cart
ExecStart=/usr/bin/dotnet run
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oteldemo-cart

# Environment
Environment=ASPNETCORE_URLS=http://*:8081
Environment=CART_PORT=8081
Environment=VALKEY_ADDR=localhost:6379
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
Environment=OTEL_SERVICE_NAME=cart
Environment=OTEL_RESOURCE_ATTRIBUTES=service.name=cart,service.version=1.0.0,deployment.environment=host

# Resource limits
MemoryMax=256M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
