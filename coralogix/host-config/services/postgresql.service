[Unit]
Description=PostgreSQL Database for OpenTelemetry Demo
After=network.target
Wants=network.target

[Service]
Type=notify
User=postgres
Group=postgres
ExecStart=/usr/bin/postgres -D /var/lib/postgresql/data
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
KillSignal=SIGINT
TimeoutSec=infinity
StandardOutput=journal
StandardError=journal
SyslogIdentifier=postgresql

# Environment
Environment=PGDATA=/var/lib/postgresql/data
Environment=POSTGRES_USER=root
Environment=POSTGRES_PASSWORD=otel
Environment=POSTGRES_DB=otel

# Resource limits
MemoryMax=256M
CPUQuota=30%

[Install]
WantedBy=multi-user.target
