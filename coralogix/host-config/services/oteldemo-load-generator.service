[Unit]
Description=OpenTelemetry Demo - Load Generator
After=network.target coralogix-collector.service frontend.service
Wants=network.target

[Service]
Type=simple
User=oteldemo
Group=oteldemo
WorkingDirectory=/opt/oteldemo/load-generator
ExecStart=/usr/bin/locust --host=http://localhost:3000 --web-host=0.0.0.0 --web-port=8090
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oteldemo-load-generator

# Environment
Environment=LOCUST_WEB_PORT=8090
Environment=LOCUST_USERS=10
Environment=LOCUST_HOST=http://localhost:3000
Environment=LOCUST_HEADLESS=false
Environment=LOCUST_AUTOSTART=true
Environment=LOCUST_BROWSER_TRAFFIC_ENABLED=true
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
Environment=OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
Environment=OTEL_SERVICE_NAME=load-generator
Environment=OTEL_RESOURCE_ATTRIBUTES=service.name=load-generator,service.version=1.0.0,deployment.environment=host
Environment=PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python
Environment=LOCUST_WEB_HOST=0.0.0.0

# Resource limits
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
