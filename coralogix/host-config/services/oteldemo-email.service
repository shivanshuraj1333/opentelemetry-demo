[Unit]
Description=OpenTelemetry Demo - Email Service
After=network.target coralogix-collector.service
Wants=network.target

[Service]
Type=simple
User=oteldemo
Group=oteldemo
WorkingDirectory=/opt/oteldemo/email
ExecStart=/usr/bin/ruby email_server.rb
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oteldemo-email

# Environment
Environment=APP_ENV=production
Environment=EMAIL_PORT=8087
Environment=OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
Environment=OTEL_SERVICE_NAME=email
Environment=OTEL_RESOURCE_ATTRIBUTES=service.name=email,service.version=1.0.0,deployment.environment=host

# Resource limits
MemoryMax=128M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
