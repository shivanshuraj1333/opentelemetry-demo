[Unit]
Description=OpenTelemetry Demo - Shipping Service
After=network.target coralogix-collector.service quote.service
Wants=network.target

[Service]
Type=simple
User=oteldemo
Group=oteldemo
WorkingDirectory=/opt/oteldemo/shipping
ExecStart=/usr/local/bin/shipping
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oteldemo-shipping

# Environment
Environment=SHIPPING_PORT=8086
Environment=QUOTE_ADDR=http://localhost:8089
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
Environment=OTEL_SERVICE_NAME=shipping
Environment=OTEL_RESOURCE_ATTRIBUTES=service.name=shipping,service.version=1.0.0,deployment.environment=host
Environment=OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta

# Resource limits
MemoryMax=64M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
