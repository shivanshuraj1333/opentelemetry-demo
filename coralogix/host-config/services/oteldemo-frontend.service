[Unit]
Description=OpenTelemetry Demo - Frontend
After=network.target coralogix-collector.service
Wants=network.target

[Service]
Type=simple
User=oteldemo
Group=oteldemo
WorkingDirectory=/opt/oteldemo/frontend
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=oteldemo-frontend

# Environment
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=FRONTEND_ADDR=http://localhost:3000
Environment=AD_ADDR=http://localhost:8080
Environment=CART_ADDR=http://localhost:8081
Environment=CHECKOUT_ADDR=http://localhost:8082
Environment=CURRENCY_ADDR=http://localhost:8083
Environment=PRODUCT_CATALOG_ADDR=http://localhost:8084
Environment=RECOMMENDATION_ADDR=http://localhost:8085
Environment=SHIPPING_ADDR=http://localhost:8086
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
Environment=OTEL_SERVICE_NAME=frontend
Environment=OTEL_RESOURCE_ATTRIBUTES=service.name=frontend,service.version=1.0.0,deployment.environment=host
Environment=OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
Environment=PUBLIC_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
Environment=WEB_OTEL_SERVICE_NAME=frontend-web

# Resource limits
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
